DATABASE_URL="postgresql://ledger:ledger@localhost:5432/apexvoid_ledger"
PORT=4000
# Session cookie signing key. Generate a real one for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="dev-only-change-me"
# false for local http://localhost dev — the browser drops Secure cookies over plain HTTP.
SESSION_COOKIE_SECURE=false
# Optional override for the keyless historical reference-rate provider.
EXCHANGE_RATE_API_URL="https://api.frankfurter.dev/v2"
# Required for per-user SePay connections. Generate once and keep it stable;
# changing it makes existing encrypted connection tokens unreadable.
# SEPAY_CREDENTIAL_ENCRYPTION_KEY="base64-fernet-key"
# SEPAY_API_BASE_URL="https://my.sepay.vn/userapi"
